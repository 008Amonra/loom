#!/usr/bin/env python3
"""Voice assistant — blind (speech) + deaf (live transcript) in one local web app.
Cross-platform (Windows / Linux / Mac). Zero installs on the client: speech comes
from the browser's Web Speech API (use Chrome or Edge). Everything runs locally,
nothing leaves the machine except the LLM call to the endpoint you configure.

Usage:
    voice-assistant [--port N] [--no-browser]

Config: ~/.config/voice-loop/config.json  (extended with llm_* + system_prompt)
The LLM endpoint is your choice — default points at a local OpenAI-compatible
server (e.g. Gemma via llama-server / LM Studio on localhost:1234). Set llm_api_key
for cloud endpoints that need one.

For blind users: open the page, everything is spoken. For deaf users: every word
appears on screen — voice output can be disabled with the "Visual mode" toggle.
"""
import argparse
import json
import os
import sys
import threading
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CFG = os.path.expanduser("~/.config/voice-loop/config.json")
DEFAULTS = {
    "voice": "en",          # en | de
    "speed": "normal",      # slow | normal | fast
    "auto_start": True,
    "llm_url": "http://localhost:1234/v1/chat/completions",
    "llm_model": "",
    "llm_api_key": "",
    "system_prompt": "You are a helpful voice assistant. Answer briefly and "
                     "precisely, in plain spoken language. Max 2 sentences.",
    "port": 8081,
}

config = dict(DEFAULTS)


def load_config():
    global config
    data = {}
    try:
        with open(CFG) as f:
            data = json.load(f)
    except Exception:
        pass
    config = dict(DEFAULTS)
    config.update({k: v for k, v in data.items() if k in DEFAULTS})


def save_config():
    try:
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        with open(CFG, "w") as f:
            json.dump(config, f, indent=2)
    except Exception as e:
        print(f"config write failed: {e}", file=sys.stderr)


