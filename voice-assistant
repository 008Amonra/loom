<script>
const log = document.getElementById('log');
const dot = document.getElementById('dot');
const statusText = document.getElementById('statusText');
let cfg = {};
let messages = [];
let recognition = null;
let listening = false;
let busy = false;
let visual = false;

const setStatus = (s, cls) => { statusText.textContent = s; dot.className = cls || ''; };
const scroll = () => log.scrollTop = log.scrollHeight;

function addBubble(role, text) {
  const d = document.createElement('div');
  d.className = 'bubble ' + (role === 'user' ? 'user' : role === 'assistant' ? 'assistant' : 'system');
  const who = document.createElement('span');
  who.className = 'who';
  who.textContent = role === 'user' ? 'You' : role === 'assistant' ? 'Assistant' : 'System';
  d.appendChild(who);
  d.appendChild(document.createTextNode(text));
  log.appendChild(d);
  scroll();
}

let interimEl = null;
function showInterim(text) {
  if (!interimEl) {
    interimEl = document.createElement('div');
    interimEl.className = 'interim';
    log.appendChild(interimEl);
  }
  interimEl.textContent = text || '';
  scroll();
}

function speak(text) {
  if (!('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = cfg.lang || 'en-US';
  u.rate = { slow: 0.8, normal: 1.0, fast: 1.25 }[cfg.speed] || 1.0;
  u.onstart = () => setStatus('speaking', 'speaking');
  u.onend = () => { if (listening) try { recognition && recognition.start(); } catch(_){} };
  speechSynthesis.speak(u);
}

async function sendLLM(text) {
  try {
    const payload = {
      model: cfg.model || '',
      messages: [{ role: 'system', content: cfg.systemPrompt || '' }].concat(messages)
    };
    const r = await fetch('/api/llm', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const j = await r.json();
    if (j.reply) {
      messages.push({ role: 'assistant', content: j.reply });
      addBubble('assistant', j.reply);
      if (!visual) speak(j.reply);
      else if (listening) try { recognition && recognition.start(); } catch(_){}
    } else {
      addBubble('system', 'LLM error: ' + (j.error || 'unknown'));
    }
  } catch (e) {
    addBubble('system', 'LLM error: ' + e.message);
  }
  busy = false;
  setStatus(listening ? 'listening' : 'idle', listening ? 'listening' : '');
}

function commit(text) {
  if (!text) return;
  messages.push({ role: 'user', content: text });
  addBubble('user', text);
  interimEl = null;
  busy = true;
  setStatus('thinking', 'thinking');
  try { recognition && recognition.stop(); } catch(_){}
  sendLLM(text);
}

function makeRecognition() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) {
    setStatus('unsupported', 'error');
    return null;
  }
  const rec = new SR();
  rec.continuous = true;
  rec.interimResults = true;
  rec.lang = cfg.lang || 'en-US';
  rec.onresult = (e) => {
    let interim = '';
    for (let i = e.resultIndex; i < e.results.length; i++) {
      const res = e.results[i];
      if (res.isFinal) commit(res[0].transcript.trim());
      else interim += res[0].transcript;
    }
    showInterim(interim);
  };
  rec.onerror = (e) => {
    if (listening && !busy && e.error !== 'aborted') { try { rec.start(); } catch(_){} }
  };
  rec.onend = () => {
    if (listening && !busy) { try { rec.start(); } catch(_){} }
  };
  return rec;
}

function startListen() {
  listening = true;
  if (!recognition) recognition = makeRecognition();
  if (!recognition) return;
  try { recognition.start(); } catch(_){}
  setStatus('listening', 'listening');
  toggleBtn.classList.add('active');
  toggleBtn.textContent = 'Stop';
}

function stopListen() {
  listening = false;
  try { recognition && recognition.stop(); } catch(_){}
  setStatus('idle', '');
  toggleBtn.classList.remove('active');
  toggleBtn.textContent = 'Listen';
}

async function loadConfig() {
  const r = await fetch('/api/config');
  cfg = await r.json();
  document.getElementById('setLang').value = cfg.lang || 'en-US';
  document.getElementById('setSpeed').value = cfg.speed || 'normal';
  document.getElementById('setLlm').value = cfg.llm_url || '';
  document.getElementById('setModel').value = cfg.model || '';
  document.getElementById('setKey').value = cfg.apiKey || '';
  document.getElementById('setPrompt').value = cfg.systemPrompt || '';
  document.getElementById('setAutoStart').checked = !!cfg.autoStart;
  const h = document.getElementById('cfgHint');
  h.textContent = 'Serving config from: ' + (cfg.configPath || '');
}

const toggleBtn = document.getElementById('toggleBtn');
toggleBtn.addEventListener('click', () => listening ? stopListen() : startListen());

const visualBtn = document.getElementById('visualBtn');
visualBtn.addEventListener('click', () => {
  visual = !visual;
  visualBtn.textContent = 'Visual mode: ' + (visual ? 'on' : 'off');
  if (visual) speechSynthesis && speechSynthesis.cancel();
});

document.getElementById('clearBtn').addEventListener('click', () => {
  messages = []; log.textContent = ''; interimEl = null;
  speechSynthesis && speechSynthesis.cancel();
});

const settingsBtn = document.getElementById('settingsBtn');
const settings = document.getElementById('settings');
settingsBtn.addEventListener('click', () => settings.classList.toggle('open'));

document.getElementById('saveBtn').addEventListener('click', async () => {
  const body = {
    lang: document.getElementById('setLang').value,
    speed: document.getElementById('setSpeed').value,
    llm_url: document.getElementById('setLlm').value.trim(),
    model: document.getElementById('setModel').value.trim(),
    apiKey: document.getElementById('setKey').value.trim(),
    systemPrompt: document.getElementById('setPrompt').value.trim(),
    autoStart: document.getElementById('setAutoStart').checked
  };
  await fetch('/api/config', { method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body) });
  await loadConfig();
  addBubble('system', 'Settings saved.');
});

addBubble('system', 'Open Settings to choose your LLM endpoint, then press Listen.');
loadConfig().then(() => {
  if (cfg.autoStart) startListen();
});
</script>
