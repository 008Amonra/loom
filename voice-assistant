"""


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/api/config":
            self._send(200, {
                "lang": "de-DE" if config["voice"] == "de" else "en-US",
                "speed": config["speed"],
                "llm_url": config["llm_url"],
                "model": config["llm_model"],
                "apiKey": config["llm_api_key"],
                "systemPrompt": config["system_prompt"],
                "autoStart": config["auto_start"],
                "configPath": CFG,
            })
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE, "text/html; charset=utf-8")
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            body = {}
        if self.path == "/api/llm":
            self._proxy_llm(body)
        elif self.path == "/api/config":
            self._update_config(body)
        else:
            self._send(404, {"error": "not found"})

    def _update_config(self, body):
        mapping = {
            "lang": lambda v: config.update(voice="de" if v == "de-DE" else "en"),
            "speed": lambda v: config.update(speed=v if v in ("slow", "normal", "fast") else "normal"),
            "llm_url": lambda v: config.update(llm_url=v),
            "model": lambda v: config.update(llm_model=v),
            "apiKey": lambda v: config.update(llm_api_key=v),
            "systemPrompt": lambda v: config.update(system_prompt=v),
            "autoStart": lambda v: config.update(auto_start=bool(v)),
        }
        for k, fn in mapping.items():
            if k not in body:
                continue
            v = body[k]
            if isinstance(v, str):
                fn(v.strip() if k != "systemPrompt" else v)
            elif isinstance(v, bool) and k == "autoStart":
                fn(v)
        save_config()
        self._send(200, {"ok": True})

    def _proxy_llm(self, body):
        if not config["llm_url"]:
            self._send(502, {"error": "no LLM endpoint configured"})
            return
        model = body.get("model") or config["llm_model"]
        payload = {
            "model": model,
            "messages": body.get("messages", []),
            "max_tokens": 300,
            "temperature": 0.7,
        }
        req = urllib.request.Request(
            config["llm_url"],
            data=json.dumps(payload).encode(),
            headers={"Content-Type": "application/json"},
        )
        if config["llm_api_key"]:
            req.add_header("Authorization", f"Bearer {config['llm_api_key']}")
        try:
            r = json.loads(urllib.request.urlopen(req, timeout=60).read())
            reply = r["choices"][0]["message"]["content"].strip()
            self._send(200, {"reply": reply})
        except Exception as e:
            self._send(502, {"error": str(e)})

    def log_message(self, *args):
        pass


def free_port(start):
    import socket
    for port in range(start, start + 20):
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    return start


def main():
    ap = argparse.ArgumentParser(description="Voice assistant web app (blind + deaf)")
    ap.add_argument("--port", type=int, default=None)
    ap.add_argument("--no-browser", action="store_true")
    args = ap.parse_args()

    load_config()
    port = args.port or free_port(int(config["port"]))

    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}"
    print(f"Voice Assistant running at {url}")
    print(f"Config: {CFG}")

    if not args.no_browser:
        threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
